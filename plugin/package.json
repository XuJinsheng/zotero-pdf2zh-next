{
    "name": "zotero-pdf2zh-next",
    "version": "5.6.0",
    "packageManager": "pnpm@12.15.0",
    "description": "PDF translation for Zotero with a local pdf2zh_next server",
    "config": {
        "addonName": "zotero-pdf2zh-next",
        "addonID": "zotero-pdf2zh-next@nightwatcher.local",
        "addonRef": "pdf2zhnext",
        "addonInstance": "pdf2zhnext",
        "prefsPrefix": "extensions.zotero.pdf2zhnext"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/XuJinsheng/zotero-pdf2zh-next.git"
    },
    "author": "XuJinsheng",
    "bugs": {
        "url": "https://github.com/XuJinsheng/zotero-pdf2zh-next/issues"
    },
    "homepage": "https://github.com/XuJinsheng/zotero-pdf2zh-next#readme",
    "license": "AGPL-3.0-or-later",
    "scripts": {
        "start": "zotero-plugin serve",
        "build": "tsc --noEmit && zotero-plugin build",
        "lint:check": "prettier --check . && eslint .",
        "lint:fix": "prettier --write . && eslint . --fix",
        "test": "node --test tests/*.mjs",
        "update-deps": "pnpm up --latest"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "zotero-plugin-toolkit": "6.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "epubjs": "github:zotero/epub.js#a6139d586b66d404f3da2b846598960c0394afc5",
        "eslint": "^10.13.0",
        "pdfjs-dist": "github:zotero-plugin-dev/zotero-pdfjs-types#c0cf0d7462e50ea65919835f89983e1704611993",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "zotero-plugin-scaffold": "^0.9.3",
        "zotero-types": "^4.1.3"
    },
    "prettier": {
        "printWidth": 80,
        "tabWidth": 4,
        "endOfLine": "lf",
        "overrides": [
            {
                "files": [
                    "*.xhtml"
                ],
                "options": {
                    "htmlWhitespaceSensitivity": "css"
                }
            }
        ]
    }
}
